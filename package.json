{
  "name": "social",
  "description": "🎉 Nextcloud becomes part of the federated social networks!",
  "version": "0.8.0",
  "authors": [
    {
      "name": "John Molakvoæ",
      "email": "skjnldsv@protonmail.com",
      "role": "Developer"
    },
    {
      "name": "Jan-Christoph Borchardt",
      "homepage": "https://jancborchardt.net",
      "role": "Designer"
    }
  ],
  "license": "agpl",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development webpack --config webpack.common.js",
    "watch": "NODE_ENV=development webpack --progress --watch --config webpack.common.js",
    "build": "NODE_ENV=production webpack --progress --config webpack.common.js",
    "serve": "NODE_ENV=development webpack serve --progress --config webpack.common.js",
    "lint": "eslint --ext .js,.vue src",
    "lint:fix": "eslint --ext .js,.vue src --fix",
    "stylelint": "stylelint src",
    "stylelint:fix": "stylelint src --fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "cypress": "npm run cypress:component && npm run cypress:e2e",
    "cypress:component": "cypress run --component",
    "cypress:e2e": "cypress run --e2e",
    "cypress:gui": "cypress open",
    "precypress:update-snapshots": "TESTING=true npm run dev"
  },
  "dependencies": {
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@nextcloud/auth": "^2.0.0",
    "@nextcloud/axios": "^2.3.0",
    "@nextcloud/dialogs": "^7.2.0",
    "@nextcloud/initial-state": "^2.0.0",
    "@nextcloud/l10n": "^2.1.0",
    "@nextcloud/logger": "^2.5.0",
    "@nextcloud/moment": "^1.2.1",
    "@nextcloud/router": "^2.0.1",
    "@nextcloud/vue": "^7.12.8",
    "@nextcloud/vue-richtext": "^2.0.4",
    "blurhash": "^2.0.5",
    "debounce": "^1.2.1",
    "floating-vue": "^5.2.2",
    "he": "^1.2.0",
    "linkify-plugin-mention": "^4.1.0",
    "linkify-string": "^4.1.0",
    "linkifyjs": "^4.1.0",
    "pinia": "^2.1.7",
    "sass": "^1.59.2",
    "tributejs": "^5.1.3",
    "twemoji": "12.0.1",
    "uuid": "^8.3.2",
    "vue": "^3.5.4",
    "vue-masonry-css": "^1.0.3",
    "vue-material-design-icons": "^5.2.0",
    "vue-router": "^4.3.3",
    "vue-tribute": "^1.0.7",
    "vue-twemoji": "^1.0.1",
    "vuex": "^4.1.0"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "browser": {
    "fs": false
  },
  "engines": {
    "node": "^20.0.0",
    "npm": "^10.0.0"
  },
  "devDependencies": {
    "@cypress/browserify-preprocessor": "^3.0.2",
    "@nextcloud/babel-config": "^1.0.0",
    "@nextcloud/browserslist-config": "^2.3.0",
    "@nextcloud/cypress": "^1.0.0-beta.2",
    "@nextcloud/eslint-config": "^8.2.1",
    "@nextcloud/stylelint-config": "^2.3.0",
    "@nextcloud/webpack-vue-config": "^5.5.1",
    "@types/node": "^20.10.6",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vue/test-utils": "^2.4.1",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^7.1.3",
    "cypress-visual-regression": "^2.1.1",
    "cypress-wait-until": "^1.7.2",
    "dockerode": "^4.0.6",
    "jest": "^29.5.0",
    "jest-serializer-vue": "^3.1.0",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "sass-loader": "^16.0.6",
    "style-loader": "^4.0.0",
    "typescript": "^5.3.3",
    "vue": "^3.5.4",
    "vue-loader": "^17.4.2",
    "wait-on": "^7.0.1",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "jest": {
    "preset": "@vue/cli-plugin-unit-jest/presets/typescript-and-babel",
    "testEnvironment": "jsdom",
    "moduleFileExtensions": [
      "js",
      "ts",
      "json",
      "vue"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.vue$": "@vue/vue3-jest",
      ".+\\.(css|styl|less|sass|scss|svg|png|jpg|ttf|woff|woff2)$": "jest-transform-stub",
      "^.+\\.tsx?$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/"
    ],
    "snapshotSerializers": [
      "jest-serializer-vue"
    ],
    "testMatch": [
      "**/tests/unit/**/*.spec.(js|jsx|ts|tsx)|**/__tests__/*.(js|jsx|ts|tsx)"
    ]
  }
}
